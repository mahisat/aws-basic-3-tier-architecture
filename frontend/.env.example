# Local dev: Vite proxies /api → http://localhost:5000 (see vite.config.ts)
VITE_API_BASE_URL=/api

# Optional — local backend without proxy:
# VITE_API_BASE_URL=http://localhost:5000/api

# Production on EC2: set at build time (see terraform/frontend-setup.sh).
# Use /api so nginx proxies to the backend private IP (recommended for public users).
# VITE_API_BASE_URL=/api

# Not for public browsers (private IP is not reachable from the internet):
# VITE_API_BASE_URL=http://10.0.2.10:5000/api
